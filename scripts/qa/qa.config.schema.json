{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://email-transfer-station.invalid/qa.config.schema.json",
  "title": "Email Transfer Station QA configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "defaultBaseUrl",
    "adminApiPrefix",
    "routes",
    "viewports",
    "defaultViewports",
    "retention"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "defaultBaseUrl": {
      "type": "string",
      "format": "uri"
    },
    "adminApiPrefix": {
      "type": "string",
      "pattern": "^/api/admin/"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          }
        }
      }
    },
    "viewports": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "width",
          "height"
        ],
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 320
          },
          "height": {
            "type": "integer",
            "minimum": 480
          }
        }
      }
    },
    "defaultViewports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumRuns",
        "days"
      ],
      "properties": {
        "minimumRuns": {
          "type": "integer",
          "minimum": 1
        },
        "days": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
